{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "outDir": "out/main",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@db/*": ["./db/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["electron/**/*", "db/**/*", "scripts/**/*", "drizzle.config.ts"]
}
